@startuml text_mask_linksafe
'============================================================================
' Figure: Quantization-safe, link-safe attention mask (Methodology, Part III)
' Labels use the THESIS vocabulary (not code identifiers). Mapping to source:
'   "−∞ sentinel"            <- code: -FLT_MAX = finfo(float32).min ≈ -3.4e38
'   "masked fill"            <- ONNX op: Where(cond, sentinel, 1−mask)
'   "cast to FP32 (internal float tensor)" <- /text_model/Cast_output_0
'   "materialized FP32 mask" <- Expand -> /Expand_coef
'   "per-tensor quantizer"   <- ONNX QuantizeLinear/DequantizeLinear (QDQ)
' Element-wise arithmetic ops are circles: (+) add, (−) subtract, (×) multiply.
' Source code:
'   export_split_text_onnx.py:78-107 ; patch_text_qnn_link_safe_mask.py:109-203
'   patch_text_finite_attention_mask.py ; inspect_text_attention_qdq.py
'============================================================================
left to right direction
skinparam shadowing false
skinparam ArrowFontSize 11
skinparam TitleFontSize 15
skinparam rectangle {
  FontSize 12
  BorderThickness 1
}
skinparam usecase {
  FontSize 14
  BorderThickness 1
  BackgroundColor #ECF0F1
}
title Quantization-safe, link-safe attention mask

' ---------------------------------------------------------------- TOP (unsafe)
rectangle "TOP — Original mask path: unbounded −∞ sentinel (rejected on HTP v68)" as TOP #FDFEFE {
  rectangle "padding mask\n<i>[B, L]</i>  integer 0/1" as A_in #FBE0E0
  rectangle "reshape" as A_rs #ECF0F1
  rectangle "expand\n(broadcast)" as A_ex #FBE0E0
  rectangle "cast to FP32" as A_cast #FBE0E0
  usecase "−" as A_sub
  rectangle "cast to bool" as A_cb #ECF0F1
  rectangle "−∞ sentinel\n(unbounded)" as A_sent #F5B7B1
  rectangle "masked fill" as A_wh #FBE0E0
  rectangle "attention scores **S**\n<i>[B, H, L, L]</i>" as A_S #ECF0F1
  usecase "+" as A_add
  rectangle "per-tensor\nquantizer" as A_qdq #F5B7B1
  rectangle "softmax" as A_sm #ECF0F1
}

A_in   --> A_rs   : "[B,1,1,L]"
A_rs   --> A_ex   : "[B,1,1,L]"
A_ex   --> A_cast : "[B,1,L,L]\nmaterialized FP32 mask\n→ HTP v68 rejects"
A_cast --> A_sub  : "internal float tensor\n→ HTP v68 rejects at link"
A_sub  --> A_cb   : "1 − mask"
A_sub  --> A_wh   : "1 − mask"
A_cb   --> A_wh   : "where padded"
A_sent --> A_wh   : "fill value"
A_wh   --> A_add  : "M_att ∈ {0, −∞}"
A_S    --> A_add  : "S"
A_add  --> A_qdq  : "S + M_att"
A_qdq  --> A_sm   : "sentinel fixes the range →\nreal logits lose resolution"

' ---------------------------------------------------------------- BOTTOM (link-safe)
rectangle "BOTTOM — Link-safe deploy mask:  M_att = (1 − mask) · (−c_mask)" as BOT #FDFEFE {
  rectangle "attention mask\n<i>[B, L]</i>  float 0/1" as B_in #E3F4E1
  rectangle "reshape" as B_rs #ECF0F1
  usecase "−" as B_sub
  rectangle "finite constant\n−c_mask\n(e.g. c_mask = 32,\nexp(−32) ≈ 1.3e−14)" as B_c #ABEBC6
  usecase "×" as B_mul #ABEBC6
  rectangle "attention scores **S**\n<i>[B, H, L, L]</i>" as B_S #ECF0F1
  usecase "+" as B_add
  rectangle "per-tensor\nquantizer" as B_qdq #ABEBC6
  rectangle "softmax" as B_sm #ECF0F1
}

B_in   --> B_rs   : "[B,1,1,L]  (float, no cast)"
B_rs   --> B_sub  : "mask  [B,1,1,L]"
B_sub  --> B_mul  : "1 − mask"
B_c    --> B_mul  : "× (−c_mask)"
B_mul  --> B_add  : "M_att = (1 − mask)·(−c_mask)\n[B,1,1,L]  (broadcast)"
B_S    --> B_add  : "S"
B_add  --> B_qdq  : "S + M_att"
B_qdq  --> B_sm   : "finite range →\nlogits keep resolution"

legend right
  |<#FBE0E0> red rect |  hazard removed for deployment |
  |<#E3F4E1> green |  link-safe replacement |
  |<#ECF0F1> grey rect |  unchanged transform |
  | ( + ) ( − ) ( × ) |  element-wise arithmetic |
endlegend
@enduml
